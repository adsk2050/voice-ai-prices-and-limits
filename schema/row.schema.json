{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/adsk2050/voice-ai-prices-and-limits/schema/row.schema.json",
  "title": "One price row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "provider",
    "product",
    "mode",
    "plan",
    "price",
    "plan_fee",
    "tax_included",
    "limits",
    "source_url",
    "evidence",
    "checked_at",
    "since"
  ],
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+(/[a-z0-9.-]+){3,}$"
    },
    "category": {
      "enum": [
        "stt",
        "tts",
        "telephony"
      ]
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "product": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "mode": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "plan": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "currency",
        "per",
        "unit"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "per": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "character",
            "minute",
            "second",
            "hour",
            "token",
            "call",
            "request"
          ]
        }
      }
    },
    "plan_fee": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "currency",
            "period"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "period": {
              "enum": [
                "month",
                "year"
              ]
            }
          }
        }
      ]
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "increment_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minimum_seconds": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "tax_included": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "limits": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests_per_minute": {
              "type": "integer",
              "minimum": 1
            },
            "concurrent": {
              "type": "integer",
              "minimum": 1
            },
            "calls_per_second": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "source_url": {
              "type": "string",
              "format": "uri"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      ]
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "evidence": {
      "type": "string",
      "minLength": 1
    },
    "checked_at": {
      "$ref": "#/$defs/date"
    },
    "since": {
      "$ref": "#/$defs/date"
    }
  }
}
